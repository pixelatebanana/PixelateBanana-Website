# Public
NEXT_PUBLIC_SITE_URL=https://pixelatebanana.com
# AdSense (leave empty to disable ads). Create 3 ad units in AdSense and paste each ID below.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# builtin = our consent banner. google = you turned on Google's certified Privacy & messaging in AdSense.
NEXT_PUBLIC_CONSENT_MODE=builtin
# Server-only secrets (never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
INQUIRY_FROM=PixelateBanana <hello@yourdomain.com>
INQUIRY_TO=you@yourdomain.com
# Optional: also save every quote/chat message to Google Sheets (server-only; tabs named Quotes and Chat)
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Admin area at /login/admin (server-only)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random string, 32+ characters (used to sign the login cookie)
ADMIN_SESSION_SECRET=
# Needed on Vercel so the admin can save changes (it commits data/admin-content.json to your repo). Not needed locally.
# Token needs "Contents: Read and write" on this repository.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
# Project dashboards (CRM) at /login/client/dashboard, /login/specialist/dashboard and /login/admin/live-projects.
# Chat needs a database: create a free Upstash Redis (or Vercel KV) and paste its REST URL and token. Not needed locally (uses data/crm.json).
# Invitation emails reuse RESEND_API_KEY and INQUIRY_FROM above.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
